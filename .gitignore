# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Production
/build
# dist/ is committed on gh-pages so the deployed site has compiled CSS

# Unpublished blog drafts. gh-pages serves every committed file, so
# drafts stay out of git entirely until published. blog/DRAFT-*.md
# renders locally for preview (unlisted) but never deploys; rename
# without the DRAFT- prefix to publish.
drafts/
blog/DRAFT-*
blog/og/DRAFT-*

# Original post images (processed copies in blog/images/ are committed)
blog/images/src/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo 